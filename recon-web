#!/usr/bin/env python3

import os
import sys

# Prevent creation of compiled bytecode files
sys.dont_write_bytecode = True

# Automatically use ./venv/bin/python3 if present and not currently active
_dir = os.path.dirname(os.path.abspath(__file__))
_venv_py = os.path.join(_dir, 'venv', 'bin', 'python3')
if os.path.exists(_venv_py) and os.path.realpath(sys.executable) != os.path.realpath(_venv_py):
    os.execv(_venv_py, [_venv_py] + sys.argv)

from backend import create_app
import argparse

parser = argparse.ArgumentParser()
parser.add_argument('--host', default='127.0.0.1', help="IP address to listen on")
parser.add_argument('--port', default=5000, help="port to bind the web server to")

args = parser.parse_args()

app = create_app()
if __name__ == '__main__':
    app.run(host=args.host, port=args.port)
